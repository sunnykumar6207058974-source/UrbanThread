# UrbanThread Backend Environment Variables
# Copy this file to .env and fill in your values

PORT=5000
NODE_ENV=development

# MongoDB Connection
# Local:  mongodb://localhost:27017/urbanthread
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/urbanthread
MONGO_URI=mongodb://localhost:27017/urbanthread

# JWT Secret (change this to a long random string in production)
JWT_SECRET=urbanthread_super_secret_jwt_key_2026
JWT_EXPIRES_IN=7d

# Frontend URL for CORS
CLIENT_URL=http://localhost:5174
